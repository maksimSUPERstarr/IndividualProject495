.idea/
.vscode/*.log
*.code-workspace
.DS_Store
Thumbs.db

# Будущие локальные файлы Django.
db.sqlite3
staticfiles/

# Временные файлы атомарного сохранения хранилища.
data/.*.tmp
data/practice.json
