# Виртуальные окружения и локальные настройки окружения.
.venv/
venv/
.env
.env.*

# Служебные файлы Python и инструментов проверки.
__pycache__/
*.py[cod]
.pytest_cache/
test-tmp/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

